{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 30,
            "statusMessage": "Validation du portfolio PM..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 60,
            "statusMessage": "Portes qualite du portfolio..."
          }
        ]
      }
    ]
  }
}
